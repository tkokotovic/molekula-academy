# ─── Molekula Academy — backend environment ───────────────────────────────────
# Copy to `.env` and fill in. NEVER commit the real .env (it is gitignored).

# Runtime
NODE_ENV=development          # set to "production" on the server
PORT=3001

# Auth — REQUIRED in production (server refuses to boot without it).
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Public app URL — used to build links in emails (password reset, etc.)
APP_URL=http://localhost:5173

# CORS — comma-separated extra allowed origins (leave empty for same-origin)
CORS_ORIGIN=

# ─── Email (Nodemailer) ───────────────────────────────────────────────────────
# If SMTP_HOST is empty, emails are logged to the console instead of sent (dev).
# Uncomment and fill in one provider:

# --- Resend (recommended) ---
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=resend
# SMTP_PASS=re_your_api_key_here

# --- Gmail App Password ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your_gmail@gmail.com
# SMTP_PASS=your_app_password

# Who emails go FROM (must match your verified sender domain)
EMAIL_FROM=Molekula Academy <noreply@molekula-academy.hr>

# Teacher notification recipient
TEACHER_EMAIL=tomislav@molekula.hr

# ─── AI grading (Claude) ──────────────────────────────────────────────────────
# When set, short-answer / chem-equation grading uses the Claude API.
# Leave empty to fall back to the keyword heuristic.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
